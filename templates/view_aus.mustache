{{!
    @template mod_scormmakercmi5/view_aus

    Status of the course and the assignable units of the activity, in the order of cmi5.xml, each with its status
    (always as text) and its launch buttons. Each button posts to launch.php with the sesskey; the form of an
    OwnWindow unit opens in a new window.

    Context variables required for this template:
    * coursestatus - "Course status: …", plain text.
    * coursestate - notstarted, inprogress or satisfied.
    * hasaus - Whether there is any unit.
    * canlaunch - Whether the Actions column with the launch buttons is shown (not for a guest).
    * launchurl - URL of launch.php.
    * cmid - Course module id.
    * sesskey - Session key.
    * aus - List of units; each has id, title (plain text), state, status (plain text), ownwindow and actions
      (mode, label, primary).

    Example context (json):
    {
        "coursestatus": "Course status: In progress",
        "coursestate": "inprogress",
        "hasaus": true,
        "canlaunch": true,
        "launchurl": "https://example.com/mod/scormmakercmi5/launch.php",
        "cmid": 5,
        "sesskey": "abc123",
        "aus": [
            {"id": 1, "title": "Unit 1", "state": "inprogress", "status": "In progress", "ownwindow": false,
             "actions": [{"mode": "Normal", "label": "Continue", "primary": true},
                         {"mode": "Browse", "label": "Browse", "primary": false}]},
            {"id": 2, "title": "Unit 2", "state": "notstarted", "status": "Not started", "ownwindow": true,
             "actions": [{"mode": "Normal", "label": "Start", "primary": true}]}
        ]
    }
}}
<p class="mod-scormmakercmi5-coursestatus" data-state="{{coursestate}}">{{coursestatus}}</p>
{{#hasaus}}
<table class="generaltable mod-scormmakercmi5-aus">
    <caption>{{#str}} aus, mod_scormmakercmi5 {{/str}}</caption>
    <thead>
        <tr>
            <th scope="col">{{#str}} autitle, mod_scormmakercmi5 {{/str}}</th>
            <th scope="col">{{#str}} austatus, mod_scormmakercmi5 {{/str}}</th>
            {{#canlaunch}}<th scope="col">{{#str}} auactions, mod_scormmakercmi5 {{/str}}</th>{{/canlaunch}}
        </tr>
    </thead>
    <tbody>
        {{#aus}}
        <tr>
            <td>{{title}}</td>
            <td><span class="mod-scormmakercmi5-status" data-state="{{state}}">{{status}}</span></td>
            {{#canlaunch}}
            <td>
                <div class="mod-scormmakercmi5-actions">
                {{#actions}}
                <form method="post" action="{{launchurl}}"{{#ownwindow}} target="_blank"{{/ownwindow}}>
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="au" value="{{id}}">
                    <input type="hidden" name="mode" value="{{mode}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-secondary{{/primary}}">{{label}}<span class="accesshide"> {{title}}</span>{{#ownwindow}} {{#pix}} i/externallink, core, {{#str}} opensinnewwindow {{/str}} {{/pix}}{{/ownwindow}}</button>
                </form>
                {{/actions}}
                </div>
            </td>
            {{/canlaunch}}
        </tr>
        {{/aus}}
    </tbody>
</table>
{{/hasaus}}
