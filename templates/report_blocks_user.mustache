{{!
    @template mod_scormmakercmi5/report_blocks_user

    Activity inside the lessons of one learner (subproject D): only the summary, blocks reached with the time and the
    media watched, and the last decision per item. No sequence of clicks and no coordinates: the heat maps exist only
    for the class. Every text from the package is escaped (double braces). No closing braces may appear in this comment.

    Context variables required for this template:
    * unavailable - The package has no analysis structure: only a notice is shown.
    * hasblocks, blocks - Blocks reached [label, lesson, time, watched].
    * hasdecisions, decisions - Decisions [block, item, type, answer].

    Example context (json):
    {
        "unavailable": false,
        "hasblocks": true, "blocks": [{"label": "Video 1", "lesson": "Lesson 1", "time": "45 secs", "watched": "100%"}],
        "hasdecisions": true,
        "decisions": [{"block": "Cards 1", "item": "Card 1", "type": "Self-assessment", "answer": "Knew"}]
    }
}}
<section class="mod-scormmakercmi5-blocks" aria-labelledby="{{uniqid}}-blocks-user-title">
    <h4 id="{{uniqid}}-blocks-user-title">{{#str}} richblocks, mod_scormmakercmi5 {{/str}}</h4>
    {{#unavailable}}
    <p>{{#str}} richblocksunavailable, mod_scormmakercmi5 {{/str}}</p>
    {{/unavailable}}
    {{^unavailable}}
    {{#hasblocks}}
    <div class="mod-scormmakercmi5-blocktablewrap">
    <table class="generaltable mod-scormmakercmi5-blocktable">
        <caption>{{#str}} richblocksuserblocks, mod_scormmakercmi5 {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} richblock, mod_scormmakercmi5 {{/str}}</th>
                <th scope="col">{{#str}} richexportlesson, mod_scormmakercmi5 {{/str}}</th>
                <th scope="col">{{#str}} richblocksusertime, mod_scormmakercmi5 {{/str}}</th>
                <th scope="col">{{#str}} richblocksuserwatched, mod_scormmakercmi5 {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#blocks}}<tr><th scope="row">{{label}}</th><td>{{lesson}}</td><td>{{time}}</td><td>{{watched}}</td></tr>{{/blocks}}
        </tbody>
    </table>
    </div>
    {{/hasblocks}}
    {{#hasdecisions}}
    <div class="mod-scormmakercmi5-blocktablewrap">
    <table class="generaltable mod-scormmakercmi5-blocktable">
        <caption>{{#str}} richblocksuserdecisions, mod_scormmakercmi5 {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} richblock, mod_scormmakercmi5 {{/str}}</th>
                <th scope="col">{{#str}} richblockitem, mod_scormmakercmi5 {{/str}}</th>
                <th scope="col">{{#str}} richdecisiontype, mod_scormmakercmi5 {{/str}}</th>
                <th scope="col">{{#str}} richdecisionanswer, mod_scormmakercmi5 {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#decisions}}<tr><th scope="row">{{block}}</th><td>{{item}}</td><td>{{type}}</td><td>{{answer}}</td></tr>{{/decisions}}
        </tbody>
    </table>
    </div>
    {{/hasdecisions}}
    {{^hasblocks}}{{^hasdecisions}}<p>{{#str}} richblocksnone, mod_scormmakercmi5 {{/str}}</p>{{/hasdecisions}}{{/hasblocks}}
    {{/unavailable}}
</section>
